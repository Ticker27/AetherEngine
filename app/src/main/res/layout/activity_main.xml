<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_install"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_install" />

    <Button
        android:id="@+id/btn_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_list" />

    <Button
        android:id="@+id/btn_blob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_blob" />

    <Button
        android:id="@+id/btn_f"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_key" />

    <Button
        android:id="@+id/btn_prefs_b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_prefs_b" />

    <Button
        android:id="@+id/btn_prefs_d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_prefs_d" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
