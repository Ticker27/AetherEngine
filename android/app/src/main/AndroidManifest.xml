<?xml version="1.0" encoding="utf-8"?>
<!-- AetherEngine manifest — โครงเต็มรูปแบบตามแบบจำลองอ้างอิง (ตัดเฉพาะระบบ login key) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ชุดสิทธิ์ตามความสามารถของ container/keep-alive (ยังไม่รวมชุดเต็มใน phase นี้) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- Flutter host (LAUNCHER) — parity: com.Entry (FlutterActivity) -->
        <activity
            android:name=".Entry"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stub เปิดแอปใน container -->
        <activity
            android:name="com.aether.container.VStubActivity"
            android:exported="false"
            android:configChanges="locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode" />

        <!-- :helper process — IPC bridge -->
        <provider
            android:name="com.aether.helper.SystemCallProvider"
            android:authorities="com.aether.helper.SystemCallProvider"
            android:process=":helper"
            android:exported="true" />

        <!-- :helper process — keep-alive daemon -->
        <service
            android:name="com.aether.helper.DaemonService"
            android:process=":helper"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="engine_keepalive" />
        </service>
        <service
            android:name="com.aether.helper.DaemonInnerService"
            android:process=":helper"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
