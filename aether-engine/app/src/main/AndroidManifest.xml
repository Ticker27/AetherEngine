<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:label="Aether"
        android:allowBackup="false">

        <activity android:name=".Entry" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proxy Activity family -->
        <activity android:name=".helper.ProxyActivity" android:exported="false" />
        <activity android:name=".helper.ProxyActivity$P0" android:exported="false" />
        <activity android:name=".helper.ProxyActivity$P1" android:exported="false" />
        <activity android:name=".helper.ProxyActivity$P2" android:exported="false" />
        <activity android:name=".helper.ProxyActivity$P3" android:exported="false" />

        <activity android:name=".helper.TransparentProxyActivity$P0" android:exported="false" />
        <activity android:name=".helper.TransparentProxyActivity$P1" android:exported="false" />
        <activity android:name=".helper.TransparentProxyActivity$P2" android:exported="false" />
        <activity android:name=".helper.TransparentProxyActivity$P3" android:exported="false" />

        <activity android:name=".helper.ProxyPendingActivity$P0" android:exported="false" />
        <activity android:name=".helper.ProxyPendingActivity$P1" android:exported="false" />
        <activity android:name=".helper.ProxyPendingActivity$P2" android:exported="false" />
        <activity android:name=".helper.ProxyPendingActivity$P3" android:exported="false" />

        <!-- Services -->
        <service android:name=".helper.DaemonService" android:exported="false" />
        <service android:name=".helper.DaemonService$DaemonInnerService" android:exported="false" />

        <service android:name=".helper.ProxyService$P0" android:exported="false" />
        <service android:name=".helper.ProxyService$P1" android:exported="false" />
        <service android:name=".helper.ProxyService$P2" android:exported="false" />
        <service android:name=".helper.ProxyService$P3" android:exported="false" />

        <service android:name=".helper.ProxyJobService$P0" android:exported="false" />
        <service android:name=".helper.ProxyJobService$P1" android:exported="false" />
        <service android:name=".helper.ProxyJobService$P2" android:exported="false" />
        <service android:name=".helper.ProxyJobService$P3" android:exported="false" />

        <service
            android:name=".helper.ProxyVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE" />

        <!-- Providers -->
        <provider android:name=".helper.ProxyContentProvider$P0" android:exported="false" android:authorities="com.aether.pc.P0" />
        <provider android:name=".helper.ProxyContentProvider$P1" android:exported="false" android:authorities="com.aether.pc.P1" />
        <provider android:name=".helper.ProxyContentProvider$P2" android:exported="false" android:authorities="com.aether.pc.P2" />
        <provider android:name=".helper.ProxyContentProvider$P3" android:exported="false" android:authorities="com.aether.pc.P3" />

        <provider android:name=".helper.SystemCallProvider" android:exported="false" android:authorities="com.aether.syscall" />
        <provider android:name=".helper.FileProvider" android:exported="false" android:authorities="com.aether.fp" />

        <!-- Receiver -->
        <receiver android:name=".helper.ProxyBroadcastReceiver" android:exported="false" />
    </application>
</manifest>
